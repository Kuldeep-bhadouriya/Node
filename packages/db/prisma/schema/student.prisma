model Student {
  id            String   @id @default(uuid())
  cardNo        String   @unique
  name          String
batch         String
  branch        String
  course        String
  fathersName   String
  mothersName   String
  address       String
  studentMobile String
  parentsMobile String
  bloodGroup    String
  photoPath     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([id])
  @@index([branch])
}
